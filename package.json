{
  "name": "astra-parabox-benchmark",
  "version": "0.1.0",
  "description": "A reproducible, screen-only Patrick's Parabox benchmark harness for GPT-6-Astra.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "bin": {
    "parabox-arena": "dist/cli.js"
  },
  "scripts": {
