    "doctor": "tsx src/cli.ts doctor",
    "demo": "tsx src/cli.ts demo"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
